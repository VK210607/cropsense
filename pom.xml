<groupId>com.example</groupId>
<artifactId>cropsense</artifactId>
<version>0.0.1-SNAPSHOT</version>
<name>cropsense</name>
<description>CropSense: 100% Java AgriTech Platform</description>

<properties>
	<java.version>17</java.version>
</properties>

<dependencies>
	<!-- Pillar 4: Web Routing -->
	<dependency>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-web</artifactId>
	</dependency>

	<!-- Pillar 4 (UI): Thymeleaf HTML Rendering -->
	<dependency>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-thymeleaf</artifactId>
	</dependency>

	<!-- Pillars 1 & 2: Database Translation (JPA) -->
	<dependency>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-data-jpa</artifactId>
	</dependency>

	<!-- Pillars 1 & 2: Embedded H2 Database Engine -->
	<dependency>
		<groupId>com.h2database</groupId>
		<artifactId>h2</artifactId>
		<scope>runtime</scope>
	</dependency>

	<!-- Pillar 3: Weka Machine Learning API -->
	<dependency>
		<groupId>nz.ac.waikato.cms.weka</groupId>
		<artifactId>weka-stable</artifactId>
		<version>3.8.6</version>
	</dependency>

	<!-- Standard Spring Boot Testing -->
	<dependency>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-test</artifactId>
		<scope>test</scope>
	</dependency>
</dependencies>

<build>
	<plugins>
		<plugin>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-maven-plugin</artifactId>
		</plugin>
	</plugins>
</build>
